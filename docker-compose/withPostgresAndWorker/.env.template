# Copy this file to .env (or run ./generate-env.sh) and replace placeholders with secure random values
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=n8n

POSTGRES_NON_ROOT_USER=n8n_user
POSTGRES_NON_ROOT_PASSWORD=__POSTGRES_NON_ROOT_PASSWORD__

ENCRYPTION_KEY=__ENCRYPTION_KEY__
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

REDIS_PASSWORD=__REDIS_PASSWORD__
GENERIC_TIMEZONE=__GENERIC_TIMEZONE__

# Route manual executions to workers (avoids deprecation warning)
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true

# External exposure (reverse proxy/tunnel) URL, keep trailing slash
WEBHOOK_URL=__WEBHOOK_URL__

# Auth token for n8n runners (Python runner)
N8N_RUNNERS_AUTH_TOKEN=__N8N_RUNNERS_AUTH_TOKEN__
