# Copy to .env (ignored) and replace every placeholder. Names follow the
# official docker-compose.yml; the rest feed docker-compose.override.yml.

# n8n and runners image tag, pinned. Upgrade by changing this one value.
N8N_VERSION=2.45.5

POSTGRES_USER=changeUser
POSTGRES_PASSWORD=changePassword
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=changeUser
POSTGRES_NON_ROOT_PASSWORD=changePassword

# Encrypts stored credentials; keep a safe copy, credentials are lost without it
ENCRYPTION_KEY=changeKey

# Shared secret between n8n, the worker, and their runners
RUNNERS_AUTH_TOKEN=changeToken

REDIS_PASSWORD=changePassword
GENERIC_TIMEZONE=Asia/Tokyo

# Public base URL (reverse proxy or tunnel)
WEBHOOK_URL=https://n8n.example.com

# SMTP for user-management mail (invitations, password resets)
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=smtp.example.com
N8N_SMTP_PORT=465
N8N_SMTP_USER=changeUser
N8N_SMTP_PASS=changePassword
N8N_SMTP_SSL=true
N8N_SMTP_SENDER=n8n@example.com
